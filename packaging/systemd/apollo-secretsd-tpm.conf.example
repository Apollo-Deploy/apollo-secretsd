# Install as a service drop-in only after device/provider qualification.
# Replace HANDLE/NAME values with trusted provisioning SHA256 TPM Names.
[Service]
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
SupplementaryGroups=tss
LoadCredential=
LoadCredential=tpm-auth:/etc/apollo-secretsd/tpm-auth
ExecStart=
ExecStart=/usr/local/bin/apollo-secretsd --require-secret-memory --tpm2 SEALED:SALT:credential=tpm-auth:SEALED_NAME:SALT_NAME
